# Buddy local environment template
#
# Copy this file to .env for local development. Never commit real secrets.
# Service URLs are placeholders until local tunnels and deployed services exist.

# App -------------------------------------------------------------------------
APP_ENV=local
PUBLIC_APP_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
UI_RENDERER=local

# Call safety -----------------------------------------------------------------
# Real venue calls are disabled by default. While ALLOW_REAL_VENUE_CALLS is
# false, outbound calls must be redirected to BUDDY_TEST_PHONE_NUMBER.
ALLOW_REAL_VENUE_CALLS=false
BUDDY_TEST_PHONE_NUMBER=+15555550100

# Bright Data -----------------------------------------------------------------
# SERP API is used for result discovery. Browser API is used through Playwright
# for page evidence collection.
BRIGHT_DATA_API_KEY=
BRIGHT_DATA_SERP_ZONE=
BRIGHT_DATA_BROWSER_API_TYPE=playwright
BRIGHT_DATA_BROWSER_PLAYWRIGHT_WS_URL=wss://brd.superproxy.io:9222

# Mapbox ----------------------------------------------------------------------
# Used for place resolution.
MAPBOX_ACCESS_TOKEN=

# Runpod / Flash reasoning ----------------------------------------------------
# RUNPOD_FLASH_BASE_URL is generated after deploying the Flash app.
RUNPOD_API_KEY=
RUNPOD_FLASH_BASE_URL=
RUNPOD_FLASH_APP_NAME=buddy
RUNPOD_FLASH_ENV=production

# Runpod LLM worker -----------------------------------------------------------
# Public URL shape is usually https://<pod-id>-<port>.proxy.runpod.net.
RUNPOD_LLM_WORKER_BASE_URL=
RUNPOD_LLM_WORKER_HEALTH_URL=
RUNPOD_LLM_WORKER_WARMUP_URL=
RUNPOD_LLM_WORKER_GENERATE_URL=
RUNPOD_LLM_WORKER_AUTH_TOKEN=
LLM_MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct

# Runpod voice worker ---------------------------------------------------------
# Fill these after the voice worker is deployed or when running it locally.
RUNPOD_VOICE_WORKER_BASE_URL=
RUNPOD_VOICE_WORKER_WS_URL=
RUNPOD_VOICE_WORKER_HEALTH_URL=
RUNPOD_VOICE_WORKER_WARMUP_URL=
RUNPOD_VOICE_WORKER_AUTH_TOKEN=
STT_MODEL=small.en
STT_MODEL_NAME=small.en
TTS_MODEL_NAME=hexgrad/Kokoro-82M
VOICE_NAME=af_heart

# Twilio ----------------------------------------------------------------------
# Get Account SID/Auth Token from Twilio Console > Account > API keys & tokens.
# Get phone numbers from Twilio Console > Phone Numbers > Manage > Active numbers.
# Public webhook URLs are generated after deploying the API or starting a tunnel.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE_NUMBER=
TWILIO_VOICE_WEBHOOK_URL=http://localhost:8000/api/twilio/voice
TWILIO_STATUS_CALLBACK_URL=http://localhost:8000/api/twilio/status
TWILIO_MEDIA_STREAM_WS_URL=ws://localhost:9000/twilio-media

# Supabase --------------------------------------------------------------------
# Current Supabase key names: publishable for browser/mobile-safe reads, secret
# for backend-only writes/admin tasks.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=
